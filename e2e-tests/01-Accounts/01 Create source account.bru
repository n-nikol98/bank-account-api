meta {
  name: Create source account
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/accounts
  body: json
  auth: none
}

body:json {
  {
    "initialBalance": 125.75,
    "currency": "EUR"
  }
}

script:post-response {
  bru.setVar("sourceAccountId", res.body.id);
}

tests {
  test("creates EUR account with the requested balance", function () {
    expect(res.status).to.equal(201);
    expect(res.body.id).to.be.a("string").that.is.not.empty;
    expect(res.body.balance).to.equal(125.75);
    expect(res.body.currency).to.equal("EUR");
  });
}

docs {
  # Create source account
  
  Creates the funded account used by the deposit and transfer scenarios that
  follow in this collection. The response ID is stored as `sourceAccountId`.
}
