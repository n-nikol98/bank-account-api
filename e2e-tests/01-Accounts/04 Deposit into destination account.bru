meta {
  name: Deposit into destination account
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/accounts/{{destinationAccountId}}/deposit
  body: json
  auth: none
}

body:json {
  {
    "amount": 25.5
  }
}

tests {
  test("deposits money and returns the updated account", function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("destinationAccountId"));
    expect(res.body.balance).to.at.least(25.5);
    expect(res.body.currency).to.equal("EUR");
  });
}
