meta {
  name: Reject invalid account request
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/accounts
  body: json
  auth: none
}

body:json {
  {
    "initialBalance": -1.00,
    "currency": "eur"
  }
}

tests {
  test("returns validation errors for invalid account data", function () {
    expect(res.status).to.equal(400);
    expect(res.body.title).to.equal("Bad Request");
    expect(res.body.detail).to.equal("Request validation failed.");
    expect(res.body.timestamp).to.be.a("string").that.is.not.empty;
    expect(res.body.errors).to.be.an("object").that.is.not.empty;
    expect(res.body.errors.initialBalance).to.be.an('array')
      .that.includes("must be greater than or equal to 0.00");
    expect(res.body.errors.currency).to.be.an('array')
      .that.includes("must be a three-letter uppercase currency code");
  });
}
