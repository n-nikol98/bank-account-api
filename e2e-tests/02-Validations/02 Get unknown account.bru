meta {
  name: Get unknown account
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/accounts/00000000-0000-0000-0000-000000000001
  body: none
  auth: none
}

tests {
  test("returns a not found errpr", function () {
    expect(res.status).to.equal(404);
    expect(res.body.title).to.equal("Not Found");
    expect(res.body.timestamp).to.be.a("string").that.is.not.empty;
    expect(res.body.detail).to.eql("Account 00000000-0000-0000-0000-000000000001 was not found.");
  });
}
